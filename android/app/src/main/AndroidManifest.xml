<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — what the app is allowed to do.

  Permissions (only what is needed):
    INTERNET            talk to YOUR Ratchet Wrench server (and GitHub for app updates)
    REQUEST_INSTALL_PACKAGES  install the app's own updates (you confirm)
    CAMERA              scan the VIN barcode, door stickers and take photos
    POST_NOTIFICATIONS  show maintenance reminders (asked at runtime)
  No location, contacts, storage or microphone access.  Gallery photos use
  Android's photo picker, which needs no permission.

  Security settings:
    allowBackup=false + dataExtractionRules  app data (incl. the encrypted
        login token) is never copied to cloud backups or other devices
    networkSecurityConfig  system certificates only; plain HTTP is further
        restricted in code (see data/Api.kt, UrlPolicy)
    Only MainActivity is exported (it's the launcher icon).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app install its OWN updates from your GitHub Releases
         (Android still asks you to confirm; see update/Updater.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Added by WorkManager but not needed (we never run a foreground service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".RatchetApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RatchetWrench"
        tools:targetApi="37">

        <!--
          PRIVACY: ML Kit bundles Google's "datatransport" library, which would
          upload anonymous usage statistics to Google.  Removing the "cct"
          backend registration below leaves the library with nowhere to send
          anything, so no telemetry leaves the phone.  (The code itself stays
          because ML Kit references it; deleting it would crash ML Kit.)
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!--
          Library components we don't need are removed, so the ONLY exported
          components left are the launcher screen and WorkManager's job
          service (which only Android itself may call: BIND_JOB_SERVICE).
        -->
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <receiver android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver" tools:node="remove" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass" />

        <!-- Receives the result of installing an app update.  Not exported:
             only Android's installer can reach it (via our PendingIntent). -->
        <receiver android:name=".update.InstallResultReceiver" android:exported="false" />

        <!-- Reviewed: the launcher activity must be exported so Android can
             open the app from its icon.  It accepts no data from other apps.
             configChanges: turning the phone does NOT rebuild the screen
             (Compose re-lays it out), so the camera stays connected and
             photos being taken or attached are never lost. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
