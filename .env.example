# .env.example — copy this file to ".env" and edit it.  The .env file holds
# your secrets: it is listed in .gitignore and must never be shared.

# ---- First login (used only when the database has no users yet) -----------
RW_ADMIN_USERNAME=admin
# Choose a long, unique password (10+ characters).  REQUIRED.
RW_ADMIN_PASSWORD=

# ---- Network -------------------------------------------------------------
# Port on your server.  Open http://SERVER-IP:8000 in a browser.
RW_PORT=8000
# Login cookies are "Secure" (HTTPS-only) by default.  If you open the app
# over plain http on your home network (no Caddy/Tailscale HTTPS yet), set
# this to false or the web login won't stick.
RW_COOKIE_SECURE=true
# Set true ONLY when Caddy (or another reverse proxy you run) is in front.
RW_TRUST_PROXY_HEADERS=false
# Extra websites allowed to call the API from a browser.  Leave empty.
RW_CORS_ORIGINS=

# ---- Login protection ------------------------------------------------------
RW_TOKEN_TTL_HOURS=720
RW_LOGIN_MAX_FAILURES=5
RW_LOGIN_LOCKOUT_MINUTES=15
RW_LOGIN_RATE_PER_MINUTE=10

# ---- Uploads -----------------------------------------------------------------
RW_MAX_IMAGE_MB=20
RW_MAX_PDF_MB=40
RW_MAX_PDF_PAGES=1500
RW_PDF_PARSE_TIMEOUT_SECONDS=30
# Reading a whole owner's manual (Specs > Fill from owner's manual) can take longer.
RW_MANUAL_PARSE_TIMEOUT_SECONDS=240
# Specs > Fill from owner's manual > "From links": the server downloads the
# https links the user pastes (public websites only). false = upload/paste only.
RW_MANUAL_LINKS_ENABLED=true

# ---- VIN decoding (outbound connection #1: vpic.nhtsa.dot.gov) --------------
RW_NHTSA_ENABLED=true
# Optional paid VIN-spec service (plug-in point; none built in yet).
RW_VIN_SPEC_PROVIDER=
RW_VIN_SPEC_API_KEY=
RW_VIN_SPEC_API_URL=

# ---- Push notifications via ntfy (outbound connection #2, optional) ---------
# e.g. https://ntfy.example.com  or  http://SERVER-IP:8080 for the bundled one.
RW_NTFY_URL=
# Access token if your ntfy server requires login.
RW_NTFY_TOKEN=

# Optional: in-app bug reports -> GitHub Issues. A fine-grained GitHub token
# with ONLY "Issues: Read and write" on the project repository (docs/BUG-REPORTS.md).
# Empty = the form opens a pre-filled GitHub page instead.
RW_ISSUE_TOKEN=
RW_REMINDER_CHECK_MINUTES=60
# Used by the optional bundled ntfy server (docker compose --profile ntfy).
NTFY_BASE_URL=http://localhost:8080
NTFY_PORT=8080

# ---- AI vision for door stickers (outbound connection #3, optional) ---------
# OFF by default.  When on, sticker photos you choose to send are uploaded to
# Anthropic's API (a third party).  Requires your own API key.
RW_AI_VISION_ENABLED=false
RW_AI_VISION_API_KEY=
RW_AI_VISION_MODEL=claude-opus-5-5

# ---- Text recognition for sticker photos uploaded on the web (local) --------
RW_OCR_ENABLED=true

# ---- Demo data (your five vehicles + sample history) --------------------------
RW_SEED_SAMPLE_DATA=false
